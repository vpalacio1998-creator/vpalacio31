# Variables de entorno de OLI (se configuran en Vercel: Settings → Environment Variables; una por entorno: Development / Preview / Production)
# La anon key de Supabase es PÚBLICA por diseño (la seguridad está en RLS y en la función oli_apply).
# NUNCA pongas aquí la service_role key: solo vive como secreto de la Edge Function en Supabase.
OLI_ENV=production
OLI_APP_URL=https://app.oli.example
OLI_SUPABASE_URL=https://TU-PROYECTO.supabase.co
OLI_SUPABASE_ANON_KEY=tu-anon-key-publica
